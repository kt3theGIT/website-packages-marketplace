<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Cancelled - Website Marketplace</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="container">
        <h1 class="logo">WebPackages</h1>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/packages">Packages</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main>
    <section class="payment-result">
      <div class="container">
        <div class="result-card error">
          <div class="result-icon">✕</div>
          <h1>Payment Cancelled</h1>
          <p>Your payment has been cancelled. No charges have been made to your account.</p>
          
          <div class="action-buttons">
            <a href="/packages" class="btn btn-primary">Try Again</a>
            <a href="/" class="btn btn-secondary">Home</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2024 Website Packages Marketplace. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
